// Firebaseコンソール > Firestore Database > ルール タブに、
// この内容をそのまま貼り付けて「公開」を押してください。
//
// 【役割の考え方】
// - users/{uid} ドキュメントの role フィールドで役割を管理します
//   ("未設定" / "管理者" / "責任者" / "シェルターメンバー" / "預りメンバー")
// - 管理者・責任者は全ての犬猫のデータを閲覧・編集できます
// - シェルターメンバーは location が「施設」の犬猫だけ閲覧・編集できます
// - 預りメンバーは、自分が assignedFosterUids に含まれている犬猫だけ閲覧できます
//   (登録できるのは管理者・責任者・シェルターメンバーのみ)
// - 新規登録した人は最初 role が「未設定」になり、管理者がこのコンソールの
//   Firestore Database > データ タブで users コレクションの中の該当ドキュメントを開き、
//   role フィールドを書き換えることで権限が有効になります
//
// 【招待コードについて】
// - config/inviteCodes ドキュメントに shelter / foster という2つのフィールドで
//   招待コードの文字列を保存しておくと、新規登録時に正しいコードを入力した人は
//   承認待ちなしですぐにその役割で使い始められます
// - このドキュメントはコード側には一切書かれておらず、Firestoreの中にしか
//   保存されないので、ブラウザのソースを見ても招待コードは分かりません
// - 招待コードの設定・変更は、Firestore Database > データ タブから
//   config コレクション > inviteCodes ドキュメントを開いて直接編集してください
//   (無ければ新規作成: コレクションID "config" / ドキュメントID "inviteCodes" /
//    フィールド shelter(文字列)・foster(文字列))
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "未設定";
    }
    function isFullAdmin() {
      return myRole() == "管理者" || myRole() == "責任者";
    }
    function isShelterMember() {
      return myRole() == "シェルターメンバー";
    }
    function catAllowsRead(catData) {
      return isFullAdmin()
        || (catData.location == "施設" && isShelterMember())
        || (catData.location == "個人宅預かり" && request.auth.uid in catData.assignedFosterUids);
    }
    // 招待コードの設定(管理者・責任者のみ読み書き可能。新規登録時の照合はルール内部のget()で行うため、
    // 一般ユーザーに読み取りを許可する必要はありません)
    match /config/inviteCodes {
      allow read, write: if isFullAdmin();
    }
    // 公開ページに表示する「団体の連絡先」の保存済みリスト(過去に入力したものを再利用できるようにする)
    match /config/contactPresets {
      allow read, write: if isFullAdmin() || isShelterMember();
    }
    // 「名前の由来(全体共通)」の保存済みリスト(兄弟猫など、同じ文章を他の子にも使い回せるようにする)
    match /config/nameOriginSharedPresets {
      allow read, write: if isFullAdmin() || isShelterMember();
    }
    // ご飯の写真の保存済みリスト(同じご飯を使っている子に写真を使い回せるようにする。
    // 画像はサイズが大きいため、1件ずつ別ドキュメントとして保存する)
    match /config/foodPhotoPresets/items/{presetId} {
      allow read, write: if isFullAdmin() || isShelterMember();
    }
    // 譲渡会の会場の保存済みリスト(同じ会場でまた開催する時に選び直せるようにする)
    match /config/eventLocationPresets {
      allow read, write: if isFullAdmin() || isShelterMember();
    }
    // 公開ページ用データ(ログイン不要で誰でも読める。書き込みは犬猫を編集できる人のみ。
    // ここには公開して良い項目だけをアプリ側で選んでミラーしており、
    // 保護場所・預かり担当者名・内部メモなどは含まれていません)
    match /publicProfiles/{catId} {
      allow read: if true;
      // 内容全体の作成・削除・編集は管理者・責任者・シェルターメンバーのみ。
      // ただし「体重の推移(weightHistory・currentWeight)」だけの更新は、
      // 日々の記録をつけられる人(預りメンバーなど)なら誰でもできるようにする
      // (自分が担当している子の体重グラフが、公開ページにもすぐ反映されるようにするため)
      allow create, delete: if isFullAdmin() || isShelterMember();
      allow update: if isFullAdmin() || isShelterMember()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["weightHistory", "currentWeight", "updatedAt"]));
    }
    // ユーザーの役割情報
    match /users/{userId} {
      // 自分の情報と、管理者・責任者はみんなの情報を読める
      allow read: if isSignedIn() && (request.auth.uid == userId || isFullAdmin());
      // 新規登録時、自分自身のドキュメントを作成することを許可。
      // role は次のいずれかの場合のみ許可:
      //   ・"未設定"(招待コードなしの通常登録)
      //   ・"シェルターメンバー"(正しいシェルター用招待コードを入力した場合)
      //   ・"預りメンバー"(正しい預り宅用招待コードを入力した場合)
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == "未設定"
        || (
          request.resource.data.role == "シェルターメンバー"
          && exists(/databases/$(database)/documents/config/inviteCodes)
          && request.resource.data.inviteCode == get(/databases/$(database)/documents/config/inviteCodes).data.shelter
        )
        || (
          request.resource.data.role == "預りメンバー"
          && exists(/databases/$(database)/documents/config/inviteCodes)
          && request.resource.data.inviteCode == get(/databases/$(database)/documents/config/inviteCodes).data.foster
        )
      );
      // role の変更は管理者・責任者のみ。本人はusername等その他項目のみ更新可能
      allow update: if isFullAdmin()
        || (isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role);
      // 削除は管理者・責任者に加えて、本人による退会(自分のドキュメントの削除)も許可
      allow delete: if isFullAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    // 犬猫本体の情報
    match /cats/{catId} {
      allow read: if isSignedIn() && catAllowsRead(resource.data);
      allow create: if isFullAdmin()
        || (isShelterMember() && request.resource.data.location == "施設");
      allow update, delete: if isFullAdmin()
        || (isShelterMember() && resource.data.location == "施設");
      // 変更履歴
      match /history/{historyId} {
        allow read, create: if isSignedIn()
          && catAllowsRead(get(/databases/$(database)/documents/cats/$(catId)).data);
      }
      // 日々の記録
      match /dailyLogs/{logId} {
        allow read, create, update, delete: if isSignedIn()
          && catAllowsRead(get(/databases/$(database)/documents/cats/$(catId)).data);
      }
      // 医療記録
      match /medicalRecords/{recordId} {
        allow read, create, update, delete: if isSignedIn()
          && catAllowsRead(get(/databases/$(database)/documents/cats/$(catId)).data);
      }
    }
  }
}
